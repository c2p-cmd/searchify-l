# All settings are optional. Search works with no keys at all (DuckDuckGo).

# Primary search backend: duckduckgo (keyless, default) or searxng (self-hosted).
SEARCH_BACKEND=duckduckgo
# Fallback backend if the primary returns nothing.
SEARCH_FALLBACK=searxng

# Your own SearXNG instance (keyless, fast). Enable JSON output in its settings.yml.
SEARXNG_URL=

# Optional cloud fallback (Google via Serper). Off unless this key is set.
SERPER_API_KEY=

# Reranker model: a Hugging Face name (default below) or a local directory
# holding your own fine-tuned cross-encoder.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Network timeout in seconds.
FETCH_TIMEOUT=15
